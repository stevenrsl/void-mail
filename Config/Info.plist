<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- mailto: (Void, any app), voidmail://message?id=… (the « Source : » line of a note sent to Void Notes),
	     and the OAuth redirect (voidmail://oauth). The other keys are generated by Xcode. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.void.mail</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voidmail</string>
				<string>mailto</string>
			</array>
		</dict>
	</array>
	<!-- OAuth client IDs, registered with each provider. Empty: that sign-in is offered but greyed,
	     with the reason. Microsoft (Outlook.com, Hotmail, Microsoft 365): an Azure app registration,
	     « Mobile and desktop applications », redirect URI voidmail://oauth, delegated permissions
	     IMAP.AccessAsUser.All, SMTP.Send, offline_access. Google: left empty on purpose (see CONCEPT.md). -->
	<key>VoidMailMicrosoftClientID</key>
	<string></string>
	<key>VoidMailGoogleClientID</key>
	<string></string>
</dict>
</plist>
